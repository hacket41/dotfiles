{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 5,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 320,
  "control-center-height": 650,
  "notification-window-width": 450,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 150,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "text-empty": "No Notification, homie :(",
  "widgets": [
    "title",
    "dnd",
    "menubar",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight"
  ],
  "widget-config": {
    "title": {
      "text": "SwayNC",
      "clear-all-button": true,
      "button-text": "󰆴 Clear all"
    },
    "menubar": {
      "menu#wifi": {
        "label": "󰤥 Wi-Fi",
        "position": "left",
        "animation-type": "slide_down",
        "actions": [
          {
            "label": "Toggle Wi-Fi",
            "type": "toggle",
            "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
            "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
          },
          {
            "label": "Connect to Network…",
            "command": "~/.config/swaync/scripts/wifi_menu.sh"
          },
          {
            "label": "Network Settings",
            "command": "nm-connection-editor"
          }
        ]
      },
      "menu#bluetooth": {
        "label": "󰂯 Bluetooth",
        "position": "left",
        "animation-type": "slide_down",
        "actions": [
          {
            "label": "Toggle Bluetooth",
            "type": "toggle",
            "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
            "update-command": "sh -c '[[ $(bluetoothctl show | grep Powered) == *yes* ]] && echo true || echo false'"
          },
          {
            "label": "Connect Device…",
            "command": "~/.config/swaync/scripts/bluetooth_menu.sh"
          },
          {
            "label": "Bluetooth Settings",
            "command": "blueman-manager"
          }
        ]
      }
    },
    "mpris": {
      "blacklist": ["playerctl"],
      "autohide": false,
      "show-album-art": "always",
      "loop-carousel": true
    },
    "backlight": {
      "label": "󰃟 ",
      "device": "intel_backlight",
      "min": 1
    },
    "volume": {
      "label": "󰕾 ",
      "height": 10,
      "position": "top-right"
    },

    "buttons-grid": {
      "actions": [
        {
          "label": "󰌾",
          "command": "hyprlock"
        },
        {
          "label": "󰕾",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
          "type": "toggle"
        },
        {
          "label": "",
          "command": "systemctl poweroff"
        },
        {
          "label": "",
          "command": "systemctl reboot"
        },
        {
          "label": "󰍬",
          "command": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
          "type": "toggle"
        },
        {
          "label": "󰑋",
          "command": "obs"
        }
      ]
    }
  }
}
